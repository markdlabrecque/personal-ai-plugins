REVIEW_CAP = 2
# Ticket sessions run unattended: each harness skips its permission prompts by
# default. Pi has none; `--approve` trusts the worktree's project resources
# (print mode skips them otherwise, interactive mode would ask). Codex runs
# its plugin hooks without per-hook trust approval.
DEFAULT_CONFIG = {"max_workers": 3, "claude_args": ["--dangerously-skip-permissions"],
