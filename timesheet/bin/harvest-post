#!/usr/bin/env python3
"""harvest-post — create Harvest time entries from a JSON file.

Replaces the hand-written `python3 -c "..."` POST loop the timesheet skill used
to retype on every run. The agent writes the planned entries to a JSON file and
calls this script; the script owns identity verification, the POST loop, error
handling, and the machine-readable result lines.

Usage:
    harvest-post --user-id 123456 entries.json
    harvest-post --user-id 123456 --dry-run entries.json
    cat entries.json | harvest-post --user-id 123456 -

Input: a JSON list of entry objects, each passed to Harvest as-is:

    [
      {"project_id": 111, "task_id": 222, "spent_date": "2026-03-23",
       "hours": 0.02, "notes": "#142 Harden auth refresh\n- Tightened validation"},
      {"project_id": 111, "task_id": 333, "spent_date": "2026-03-23",
       "hours": 0.02, "notes": ""}
    ]

Environment:
    HARVEST_TOKEN, HARVEST_ACCOUNT_ID — required (see the plugin README).

Output: one pipe-delimited line per entry, in input order.

    OK|<entry_id>|<spent_date>|<project name>|<hours>
    FAIL|<index>|<http status>|<message>

Exit status: 0 when every entry was created, 1 when any entry failed, 2 on a
usage/config/identity error (nothing was posted).
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

API = "https://api.harvestapp.com/v2"
REQUIRED_FIELDS = ("project_id", "task_id", "spent_date", "hours")


def die(message):
    print(f"harvest-post: {message}", file=sys.stderr)
    sys.exit(2)


def build_headers():
    token = os.environ.get("HARVEST_TOKEN")
    account_id = os.environ.get("HARVEST_ACCOUNT_ID")
    if not token or not account_id:
        die("HARVEST_TOKEN and HARVEST_ACCOUNT_ID must be set in the environment")
    return {
        "Authorization": f"Bearer {token}",
        "Harvest-Account-Id": account_id,
        "User-Agent": "Claude-Timesheet-Skill",
        "Content-Type": "application/json",
    }


def api_get(path, headers):
    req = urllib.request.Request(f"{API}{path}", headers=headers)
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())


def load_entries(path):
    raw = sys.stdin.read() if path == "-" else open(path, encoding="utf-8").read()
    try:
        entries = json.loads(raw)
    except json.JSONDecodeError as exc:
        die(f"input is not valid JSON: {exc}")
    if not isinstance(entries, list) or not entries:
        die("input must be a non-empty JSON list of entry objects")
    for index, entry in enumerate(entries):
        if not isinstance(entry, dict):
            die(f"entry {index} is not a JSON object")
        missing = [field for field in REQUIRED_FIELDS if field not in entry]
        if missing:
            die(f"entry {index} is missing required field(s): {', '.join(missing)}")
    return entries


def verify_identity(expected_user_id, headers):
    """A token can silently belong to a different Harvest user — never write blind."""
    try:
        me = api_get("/users/me", headers)
    except urllib.error.HTTPError as exc:
        die(f"could not verify identity: HTTP {exc.code} {exc.reason}")
    except urllib.error.URLError as exc:
        die(f"could not reach the Harvest API: {exc.reason}")
    if me["id"] != expected_user_id:
        die(
            f"token belongs to user {me['id']} "
            f"({me.get('first_name', '')} {me.get('last_name', '')}, {me.get('email', '')}), "
            f"not the expected user {expected_user_id} — nothing was posted"
        )


def post_entry(entry, headers):
    req = urllib.request.Request(
        f"{API}/time_entries",
        data=json.dumps(entry).encode(),
        headers=headers,
        method="POST",
    )
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())


def main():
    parser = argparse.ArgumentParser(add_help=True, description=__doc__)
    parser.add_argument("entries", help="path to the entries JSON file, or - for stdin")
    parser.add_argument(
        "--user-id",
        type=int,
        required=True,
        help="expected Harvest user id; the run aborts if the token resolves to anyone else",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate input and identity, print what would be posted, POST nothing",
    )
    args = parser.parse_args()

    headers = build_headers()
    entries = load_entries(args.entries)
    verify_identity(args.user_id, headers)

    if args.dry_run:
        for entry in entries:
            print(
                f"DRY|{entry['spent_date']}|project {entry['project_id']}"
                f"|task {entry['task_id']}|{entry['hours']}"
            )
        return 0

    failures = 0
    for index, entry in enumerate(entries):
        try:
            result = post_entry(entry, headers)
            print(
                f"OK|{result['id']}|{result['spent_date']}"
                f"|{result['project']['name']}|{result['hours']}"
            )
        except urllib.error.HTTPError as exc:
            failures += 1
            try:
                message = json.loads(exc.read()).get("message", exc.reason)
            except (ValueError, OSError):
                message = exc.reason
            print(f"FAIL|{index}|{exc.code}|{message}")
        except urllib.error.URLError as exc:
            failures += 1
            print(f"FAIL|{index}|network|{exc.reason}")
        sys.stdout.flush()

    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
